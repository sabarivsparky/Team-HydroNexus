# ─── HydroNexus H2S Dosimeter backend configuration ─────────
# Copy to backend/.env and adjust. NEVER commit the real .env.

# SQLite (local dev default):
DATABASE_URL=sqlite:///./data/hydronexus.db
# PostgreSQL (production, e.g. Render/Railway):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/hydronexus

# Generate a real secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Cumulative-dose action level shown across dashboards (ppm·hr)
ACTION_LEVEL_PPM_HR=10

# Wristband shelf life claim (days) — REQUIRES aging validation
SHELF_LIFE_DAYS=90
